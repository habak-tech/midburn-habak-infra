{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "habak-backup-starter",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "GCP_PROJECT": "midburn-habak",
    "GCP_ZONE": "me-west1-c",
    "GCP_INSTANCE": "midburn-habak-cloud-backup"
  },
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "842671",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "START_LIMITER",
      "namespace_id": "842672",
      "simple": { "limit": 1, "period": 60 }
    }
  ]
}
