# Listener ports; configure login origins in authelia/session.yml.
HTTP_PORT=8181
HTTPS_PORT=8543
# Certificate names, used only when the persistent certificate is first generated.
# Example: DNS:habak.local,IP:192.168.1.10
TLS_CERT_SAN=DNS:localhost,IP:127.0.0.1
# Unmatched paths redirect here; use a same-origin path or an absolute URL.
CATCH_ALL_REDIRECT_URL=/ops/
# Optional remotely managed Cloudflare tunnel:
CLOUDFLARE_TUNNEL_TOKEN=
